# Required unless the Bivia CLI is already set up: the Bivia decision model API key.
# browser-cli resolves the key in this order:
#   1. --api-key flag  2. A8_API_KEY  3. BIVIA_API_KEY  4. ~/.bivia/config
# If you use the Bivia CLI (key saved at ~/.bivia/config), you can leave these unset.
A8_API_KEY=

# Optional: override the Bivia base URL
# A8_BASE_URL=https://api.articul8.ai/bivia

# Optional: small text model for the TYPE_TEXT operation (OpenAI-compatible).
# Without this, TYPE_TEXT falls back to typing the goal text.
TEXT_MODEL_API_KEY=
# TEXT_MODEL=openai/gpt-4o-mini
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
