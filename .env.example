# Required: Bivia decision model API key (https://docs.articul8.ai/bivia/)
A8_API_KEY=

# Optional: override the Bivia base URL
# A8_BASE_URL=https://api.articul8.ai/bivia

# Optional: small text model for the TYPE_TEXT operation (OpenAI-compatible).
# Without this, TYPE_TEXT falls back to typing the goal text.
TEXT_MODEL_API_KEY=
# TEXT_MODEL=openai/gpt-4o-mini
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
